# ══════════════════════════════════════════════════════════════
# .env.example — KLEM Technologies (Hostinger production)
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS committer .env dans Git.
# ══════════════════════════════════════════════════════════════

# ── Base de données ───────────────────────────────────────────
# Valeurs disponibles dans hPanel → Bases de données → MySQL
DB_NAME=u123456_klem
DB_USER=u123456_klem
DB_PASSWORD=VotreMotDePasseDB
DB_HOST=localhost

# ── Environnement ─────────────────────────────────────────────
WP_ENV=production

# ── URLs (remplacer par le vrai domaine) ──────────────────────
WP_HOME=https://www.klemtech.net
WP_SITEURL=https://www.klemtech.net/wp

# ── Clés de sécurité WordPress ────────────────────────────────
# Générer sur : https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=REMPLACER_PAR_CLE_UNIQUE
SECURE_AUTH_KEY=REMPLACER_PAR_CLE_UNIQUE
LOGGED_IN_KEY=REMPLACER_PAR_CLE_UNIQUE
NONCE_KEY=REMPLACER_PAR_CLE_UNIQUE
AUTH_SALT=REMPLACER_PAR_SEL_UNIQUE
SECURE_AUTH_SALT=REMPLACER_PAR_SEL_UNIQUE
LOGGED_IN_SALT=REMPLACER_PAR_SEL_UNIQUE
NONCE_SALT=REMPLACER_PAR_SEL_UNIQUE

# ── Email — API Brevo ─────────────────────────────────────────
# Clé disponible sur : https://app.brevo.com/settings/keys/api
KLEM_BREVO_API_KEY=xkeysib-VOTRE_CLE_API_BREVO
KLEM_SMTP_FROM=infos@klemtech.net
KLEM_SMTP_FROM_NAME=KLEM Technologies & Services
