# URL du backend Spring Boot
# En dev local : http://localhost:8081/api/v1
# En production Railway : https://<ton-projet>.up.railway.app/api/v1
VITE_API_URL=http://localhost:8081/api/v1

# Localité affichée sur la page d'accueil publique — ne pas figer l'app sur un pays/ville :
# à adapter par déploiement si Cantine Connect s'étend à un autre pays ou une autre ville.
VITE_APP_PAYS=Côte d'Ivoire
VITE_APP_VILLE_REFERENCE=Abidjan
