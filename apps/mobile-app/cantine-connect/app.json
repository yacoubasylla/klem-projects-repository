{
  "expo": {
    "name": "Cantine Connect",
    "slug": "cantine-connect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cantineconnect",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F2"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "pwa": {
        "name": "Cantine Connect - KLEM",
        "shortName": "CantineConnect",
        "themeColor": "#E8720C",
        "backgroundColor": "#FFF9F2",
        "display": "standalone",
        "scope": "/",
        "startUrl": "/"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser l'accès à la caméra pour scanner les QR codes repas lors de la distribution."
        }
      ]
    ]
  }
}
